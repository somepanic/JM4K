<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.jellymod"
       name="JellyMod (JM4K)"
       version="0.1.0"
       provider-name="pannal, FilHarr, samtheruby">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.27.1+matrix.1"/>
        <import addon="script.module.six" version="1.15.0+matrix.1"/>
        <import addon="script.module.kodi-six" version="0.1.3.1" />
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.python.pluginsource" library="plugin.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.ui.screensaver" library="screensaver.py"/>
    <extension point="xbmc.service" library="service.py" />
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">JellyMod for Kodi: browse and play your Jellyfin server</summary>
        <description lang="en_GB">Unofficial Jellyfin client for Kodi, built on Plex Uno (a reworked fork of PlexMod for Kodi)</description>
        <disclaimer lang="en">This add-on is not made or supported by the Jellyfin project or by Plex</disclaimer>

        <license>GPL-2.0-only</license>
        <website>https://jellyfin.org</website>
        <platform>all</platform>
        <news>
0.1.0 - early development
- JellyMod (JM4K) is being adapted from SM4K and Plex Uno to connect to Jellyfin servers
        </news>
        <assets>
            <icon>icon2.png</icon>
            <fanart>fanart.png</fanart>
        </assets>
    </extension>
</addon>
